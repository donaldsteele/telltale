# The bubbles server that TestServerEndToEnd (server_test.go) runs: the
# version telltale's go.mod requires, and the commit that version's tag must
# point at. The test fails when the version differs from go.mod's, and
# builds bubbles only from a checkout whose HEAD is this commit. CI clones
# the tag and checks the commit before the lab job (.github/workflows/ci.yml).
BUBBLES_VERSION=v0.4.0
BUBBLES_COMMIT=c11b2bc1f673a273ab58661ec5da98cddb210926
