{
  "requires": {"variant": "thirdparty"},
  "with_snapshot": {
    "comment": "A checklist item that was not met when the snapshot was taken and is still not met stays a weak setting (the spec raises only items that passed then and fail now). Nothing but such items may rank above a note here; TestCleanMachinesAreClean checks that.",
    "must": [
      {"key_prefix": "heur.persist_link_pkg:/etc/cron.daily/lab-vendor", "severity": "note"},
      {"key_prefix": "heur.user_unit:/home/lab/.config/systemd/user/default.target.wants/lab-agent.service", "severity": "note"}
    ],
    "must_not_severity_above": "weak setting"
  },
  "without_snapshot": {
    "must": [
      {"key_prefix": "heur.persist_link_pkg:/etc/cron.daily/lab-vendor", "severity": "note"},
      {"key_prefix": "heur.user_unit:/home/lab/.config/systemd/user/default.target.wants/lab-agent.service", "severity": "note"}
    ],
    "must_not_severity_above": "weak setting"
  }
}
